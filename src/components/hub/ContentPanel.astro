---
import type { Category, TopicCategory } from '../../data/types';
import Icon from '../Icon.astro';
import LoopCard from '../bucles/LoopCard.astro';
import MethodCard from '../estructuras/MethodCard.astro';
import TierFilter from '../TierFilter.astro';

interface Props {
  panelKey: string;
  data: Category | TopicCategory;
  kind: 'methods' | 'topics';
  activeKey: string;
}

const { panelKey, data, kind, activeKey } = Astro.props;
const category = data as Category;
const topicCategory = data as TopicCategory;
---

<section class="category" data-category-panel={panelKey} hidden={panelKey !== activeKey}>
  <nav class="breadcrumb" aria-label="Ruta de navegación">
    <span>Inicio</span>
    <Icon name="chevron" size={12} />
    <span>{data.breadcrumb}</span>
  </nav>

  <h2 class="category__title">{data.title}</h2>
  <p class="category__desc">{data.description}</p>

  <div class="props-card">
    <div class="props-card__corner">
      <svg xmlns="http://www.w3.org/2000/svg" width="28.5" height="34.5" class="props-card__corner-svg" viewBox="0 0 57 69" preserveAspectRatio="none" aria-hidden="true">
        <path fill="var(--color-bg)" d="M54 0V0.716804C54 25.9434 35.0653 47.1517 10 50L0 57V0H54Z"></path>
        <path fill="var(--color-accent)" d="M56.9961 4.15364C57.0809 2.49896 55.8083 1.08879 54.1536 1.00394C52.499 0.919082 51.0888 2.19168 51.0039 3.84636L56.9961 4.15364ZM9.09704 51.7557L8.49716 48.8163L9.09704 51.7557ZM6 69V59.2227H0V69H6ZM9.69692 54.6951L14.3373 53.7481L13.1375 47.8693L8.49716 48.8163L9.69692 54.6951ZM14.3373 53.7481C38.202 48.8777 55.7486 28.4783 56.9961 4.15364L51.0039 3.84636C49.8967 25.4384 34.3213 43.5461 13.1375 47.8693L14.3373 53.7481ZM6 59.2227C6 57.0268 7.54537 55.1342 9.69692 54.6951L8.49716 48.8163C3.55195 49.8255 0 54.1756 0 59.2227H6Z"></path>

      </svg>
      <span class="props-card__info" role="img" aria-label="Información sobre las propiedades">
        <Icon name="info" size={13} />
      </span>
      <div class="line-card"></div>
    </div>
    <p class="props-card__label">
      <Icon name="layers" size={13} />
      Propiedades
    </p>
    <ul class="props" aria-label="Propiedades informativas">
      {data.properties.map((property) => <li class="prop">{property}</li>)}
    </ul>
  </div>

  <div class="filters-row">
    <TierFilter />
  </div>

  <div class="timeline" data-timeline={panelKey}>
    {kind === 'methods' &&
      panelKey === activeKey &&
      category.methods.map((method) => <MethodCard method={method} />)}
    {kind === 'topics' &&
      panelKey === activeKey &&
      topicCategory.topics.map((topic) => <LoopCard topic={topic} />)}
  </div>

  <p class="empty" data-empty hidden>
    Sin resultados para «<span data-empty-query></span>» en {data.breadcrumb}.
  </p>
</section>

<style is:global>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .category__title {
    margin-top: var(--space-3);
    font-size: var(--fs-2xl);
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .category__desc {
    margin: var(--space-3) 0 var(--space-4);
    max-width: 70ch;
    color: var(--color-text-muted);
  }

  .props {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-3);
    margin: 0;
    padding: 0;
  }

  .props-card {
    display: block;
    position: relative;
    overflow: visible;
    margin-bottom: var(--space-5);
    padding: var(--space-3) var(--space-4) var(--space-3) 38px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .line-card {
    position: absolute;
    top: 31px;
    bottom: 0;
    left: -1px;
    width: 3px;
    background: var(--color-accent);
    border-radius: 0 0 100px 100px;
  }

  .props-card__corner {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: 2;
    width: 43px;
    overflow: visible;
    pointer-events: none;
  }

  .props-card__corner-svg {
    display: block;
    overflow: visible;
    margin-top: -1.5px;
    margin-left: -1.2px;
  }

  .props-card__corner-fill {
    fill: var(--color-bg);
  }

  .props-card__corner-line {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .props-card__info {
    position: absolute;
    top: -5px;
    left: -5px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: var(--color-accent);
    background: var(--color-bg);
    border: 1px solid var(--color-accent-border);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--color-bg);
  }

  .props-card__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .props-card__label svg {
    opacity: 0.85;
  }

  .prop {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    padding: 2px 0;
  }

  .prop:not(:last-child)::after {
    content: '·';
    position: absolute;
    right: calc(var(--space-3) * -1);
    color: var(--color-text-dim);
  }

  .filters-row {
    display: block;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-left: 34px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 12px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-border) 8%,
      var(--color-border) 92%,
      transparent
    );
  }

  .empty {
    margin: var(--space-5) 0 0;
    padding: var(--space-5);
    text-align: center;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  .empty span {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  @media (max-width: 820px) {
    .timeline {
      padding-left: 24px;
    }

    .timeline::before {
      left: 8px;
    }

    .category__title {
      font-size: var(--fs-xl);
    }
  }
</style>
