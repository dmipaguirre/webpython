---
import rawData from '../data/pythonData.json';
import type { Category, PythonData } from '../data/types';
import Icon from './Icon.astro';
import MethodCard from './MethodCard.astro';
import TierFilter from './TierFilter.astro';

const pythonData = rawData as PythonData;

const categories: { key: string; data: Category }[] = Object.entries(pythonData).map(
  ([key, data]) => ({ key, data })
);

const categoryIcons: Record<string, string> = {
  listas: 'list',
  tuplas: 'layers',
  diccionarios: 'book',
  sets: 'target'
};

const initialKey = 'listas';
const totalMethods = categories.reduce((total, { data }) => total + data.methods.length, 0);
---

<header class="hub-header">
  <div class="hub-header__inner">
    <div class="brand">
      <span class="brand__mark"><Icon name="terminal" size={18} /></span>
      <div class="brand__text">
        <p class="brand__title">
          Python Methods Reference <span class="brand__version">v3.12</span>
        </p>
        <p class="brand__subtitle">Métodos nativos de estructuras de datos</p>
      </div>
    </div>

    <div class="search">
      <span class="search__icon"><Icon name="search" size={16} /></span>
      <input
        class="search__input"
        id="hub-search"
        type="search"
        placeholder="Buscar métodos, firmas o parámetros…"
        aria-label="Buscar métodos"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search__kbd">/</kbd>
    </div>
  </div>
</header>

<div class="hub">
  <aside class="sidebar">
    <p class="sidebar__label">Estructuras</p>
    <ul class="sidebar__list">
      {
        categories.map(({ key, data }) => (
          <li>
            <button
              type="button"
              class={`cat-btn${key === initialKey ? ' is-active' : ''}`}
              data-category-btn={key}
              aria-pressed={key === initialKey}
            >
              <span class="cat-btn__icon">
                <Icon name={categoryIcons[key]} size={15} />
              </span>
              <span class="cat-btn__name">{data.breadcrumb}</span>
              <span class="cat-btn__badge">{data.methods.length}</span>
            </button>
          </li>
        ))
      }
    </ul>

    <div class="sidebar__foot">
      <span class="sidebar__foot-dot" aria-hidden="true"></span>
      <p>{totalMethods} métodos documentados</p>
    </div>
  </aside>

  <main class="content">
    {
      categories.map(({ key, data }) => (
        <section class="category" data-category-panel={key} hidden={key !== initialKey}>
          <nav class="breadcrumb" aria-label="Ruta de navegación">
            <span>Inicio</span>
            <Icon name="chevron" size={12} />
            <span>{data.breadcrumb}</span>
          </nav>

          <h2 class="category__title">{data.title}</h2>
          <p class="category__desc">{data.description}</p>

          <ul class="props">
            {data.properties.map((property) => (
              <li class="prop">{property}</li>
            ))}
          </ul>

          <div class="filters-row">
            <TierFilter />
          </div>

          <div class="timeline" data-timeline={key}>
            {
              key === initialKey &&
                data.methods.map((method) => <MethodCard method={method} />)
            }
          </div>

          <p class="empty" data-empty hidden>
            Sin resultados para «<span data-empty-query></span>» en {data.breadcrumb}.
          </p>
        </section>
      ))
    }

    {
      categories
        .filter(({ key }) => key !== initialKey)
        .map(({ key, data }) => (
          <template data-cards={key}>
            {data.methods.map((method) => (
              <MethodCard method={method} />
            ))}
          </template>
        ))
    }
  </main>

  <aside class="toc-panel">
    <p class="toc-panel__label">En esta página</p>
    {
      categories.map(({ key, data }) => (
        <ul class="toc" data-toc={key} hidden={key !== initialKey}>
          {data.methods.map((method) => (
            <li>
              <a class="toc__link" href={`#${method.id}`} data-toc-link={method.id}>
                <span class="toc__dot" aria-hidden="true" />
                {method.name}
              </a>
            </li>
          ))}
        </ul>
      ))
    }
  </aside>
</div>

<script>
  import Prism from 'prismjs';
  import 'prismjs/components/prism-python';
  import 'prismjs/themes/prism-tomorrow.css';

  const searchInput = document.getElementById('hub-search') as HTMLInputElement | null;
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-category-panel]'));
  const categoryButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-btn]'));
  const tocLists = Array.from(document.querySelectorAll<HTMLElement>('[data-toc]'));
  const tierButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tier-filter]'));

  let activeCategory = 'listas';
  let activeTier = 'all';
  let query = '';

  const timers = new WeakMap<Element, ReturnType<typeof setTimeout>>();

  const activePanel = () => panels.find((panel) => panel.dataset.categoryPanel === activeCategory);

  const activeToc = () => tocLists.find((toc) => toc.dataset.toc === activeCategory);

  function syncTierButtons() {
    tierButtons.forEach((button) => {
      const isActive = button.dataset.tierFilter === activeTier;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });
  }

  function applyFilters() {
    const panel = activePanel();
    const toc = activeToc();
    if (!panel) return;

    const cards = Array.from(panel.querySelectorAll<HTMLElement>('[data-method-card]'));
    let visible = 0;

    cards.forEach((card) => {
      const tierMatches = activeTier === 'all' || card.dataset.tier === activeTier;
      const searchMatches = !query || (card.dataset.search ?? '').includes(query);
      const show = tierMatches && searchMatches;
      card.hidden = !show;
      if (show) visible += 1;
    });

    if (toc) {
      toc.querySelectorAll<HTMLElement>('li').forEach((item) => {
        const link = item.querySelector<HTMLElement>('[data-toc-link]');
        const card = link ? document.getElementById(link.dataset.tocLink ?? '') : null;
        item.hidden = card ? card.hidden : false;
      });
    }

    panel.querySelectorAll<HTMLElement>('[data-results]').forEach((label) => {
      label.textContent = `${visible} / ${cards.length} métodos`;
    });

    const empty = panel.querySelector<HTMLElement>('[data-empty]');
    const emptyQuery = panel.querySelector<HTMLElement>('[data-empty-query]');
    if (empty) {
      empty.hidden = visible !== 0;
      if (emptyQuery) emptyQuery.textContent = query || 'filtros actuales';
    }
  }

  function stashTimeline(panel: HTMLElement) {
    const timeline = panel.querySelector<HTMLElement>('[data-timeline]');
    if (!timeline || timeline.childElementCount === 0) return;

    const key = panel.dataset.categoryPanel ?? '';
    let source = document.querySelector<HTMLTemplateElement>(`template[data-cards="${key}"]`);

    if (!source) {
      source = document.createElement('template');
      source.dataset.cards = key;
      panel.appendChild(source);
    }

    source.content.append(...Array.from(timeline.childNodes));
  }

  function hydrateTimeline(panel: HTMLElement, key: string) {
    const timeline = panel.querySelector<HTMLElement>('[data-timeline]');
    if (!timeline || timeline.childElementCount > 0) return;

    const source = document.querySelector<HTMLTemplateElement>(`template[data-cards="${key}"]`);
    if (!source || source.content.childElementCount === 0) return;

    timeline.appendChild(source.content);
    Prism.highlightAllUnder(timeline);
  }

  function setCategory(key: string) {
    activeCategory = key;
    activeTier = 'all';
    query = '';
    if (searchInput) searchInput.value = '';

    const panel = activePanel();

    panels.forEach((item) => {
      const isActive = item.dataset.categoryPanel === key;
      item.hidden = !isActive;
      if (!isActive) stashTimeline(item);
    });

    if (panel) hydrateTimeline(panel, key);

    tocLists.forEach((toc) => {
      toc.hidden = toc.dataset.toc !== key;
    });

    categoryButtons.forEach((button) => {
      const isActive = button.dataset.categoryBtn === key;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });

    syncTierButtons();
    applyFilters();
    window.scrollTo({ top: 0 });
  }

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const helper = document.createElement('textarea');
      helper.value = text;
      helper.setAttribute('readonly', '');
      helper.style.position = 'fixed';
      helper.style.opacity = '0';
      document.body.appendChild(helper);
      helper.select();
      document.execCommand('copy');
      helper.remove();
    }
  }

  function flash(element: Element, label: Element, message: string, restore: string) {
    element.classList.add('is-copied');
    label.textContent = message;

    const previous = timers.get(element);
    if (previous) clearTimeout(previous);

    timers.set(
      element,
      setTimeout(() => {
        element.classList.remove('is-copied');
        label.textContent = restore;
      }, 1600)
    );
  }

  categoryButtons.forEach((button) => {
    button.addEventListener('click', () => setCategory(button.dataset.categoryBtn ?? 'listas'));
  });

  tierButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeTier = button.dataset.tierFilter ?? 'all';
      syncTierButtons();
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', () => {
    query = searchInput.value.toLowerCase().trim();
    applyFilters();
  });

  document.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const copyButton = target.closest<HTMLElement>('[data-copy]');
    if (copyButton) {
      const code = copyButton.closest('.codebox')?.querySelector('code');
      const label = copyButton.querySelector('.copy-btn__label');
      if (code && label) {
        await copyText(code.textContent ?? '');
        flash(copyButton, label, '¡Copiado!', 'Copiar');
      }
      return;
    }

    const anchor = target.closest<HTMLAnchorElement>('[data-copy-link]');
    if (anchor) {
      event.preventDefault();
      const hash = anchor.getAttribute('href') ?? '';
      await copyText(`${window.location.origin}${window.location.pathname}${hash}`);
      const toast = anchor.querySelector('.anchor__toast');
      if (toast) flash(anchor, toast, '¡Copiado!', '¡Copiado!');
      window.history.replaceState(null, '', hash);
    }
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    const typing =
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      (target instanceof HTMLElement && target.isContentEditable);

    if (event.key === '/' && !typing && searchInput) {
      event.preventDefault();
      searchInput.focus();
      searchInput.select();
    }

    if (event.key === 'Escape' && document.activeElement === searchInput && searchInput.value) {
      searchInput.value = '';
      query = '';
      applyFilters();
    }
  });

  applyFilters();
  Prism.highlightAll();

  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    searchInput?.focus({ preventScroll: true });
  }
</script>

<style>
  .hub-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-header);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
  }

  .hub-header__inner {
    max-width: 1440px;
    margin: 0 auto;
    min-height: var(--header-height);
    padding: 10px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .brand__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent-border);
  }

  .brand__text {
    min-width: 0;
  }

  .brand__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand__version {
    color: var(--color-accent);
    font-size: var(--fs-sm);
  }

  .brand__subtitle {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    max-width: 440px;
  }

  .search__icon {
    position: absolute;
    left: 12px;
    display: inline-flex;
    color: var(--color-text-dim);
    pointer-events: none;
  }

  .search__input {
    width: 100%;
    padding: 9px 46px 9px 36px;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    outline: none;
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .search__input::placeholder {
    color: var(--color-text-dim);
  }

  .search__input:focus {
    border-color: var(--color-accent-border);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }

  .search__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .search__kbd {
    position: absolute;
    right: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    font-size: var(--fs-xs);
    color: var(--color-text-dim);
    background: var(--color-surface-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    pointer-events: none;
  }

  .hub {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr) 232px;
    gap: var(--space-6);
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--space-5) 24px 96px;
    align-items: start;
  }

  .sidebar,
  .toc-panel {
    position: sticky;
    top: calc(var(--header-height) + var(--space-5));
    max-height: calc(100vh - var(--header-height) - var(--space-6));
    overflow-y: auto;
  }

  .sidebar__label,
  .toc-panel__label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-text-dim);
  }

  .sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cat-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 10px 12px;
    font-size: var(--fs-base);
    color: var(--color-text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-align: left;
    transition:
      color 0.18s ease,
      background-color 0.18s ease,
      border-color 0.18s ease;
  }

  .cat-btn:hover {
    color: var(--color-text);
    background: var(--color-surface);
    border-color: var(--color-border);
  }

  .cat-btn.is-active {
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border-color: var(--color-accent-border);
  }

  .cat-btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background: var(--color-surface-3);
    color: inherit;
  }

  .cat-btn.is-active .cat-btn__icon {
    background: rgba(249, 115, 22, 0.2);
  }

  .cat-btn__name {
    flex: 1;
    font-family: var(--font-display);
    font-size: var(--fs-md);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cat-btn__badge {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-dim);
    background: var(--color-surface-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 1px 8px;
  }

  .cat-btn.is-active .cat-btn__badge {
    color: var(--color-accent);
    border-color: var(--color-accent-border);
    background: transparent;
  }

  .sidebar__foot {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-soft);
    font-size: var(--fs-xs);
    color: var(--color-text-dim);
  }

  .sidebar__foot p {
    margin: 0;
  }

  .sidebar__foot-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.15);
  }

  .content {
    min-width: 0;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .category__title {
    margin-top: var(--space-3);
    font-size: var(--fs-2xl);
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .category__desc {
    margin: var(--space-3) 0 var(--space-4);
    max-width: 70ch;
    color: var(--color-text-muted);
  }

  .props {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 0;
  }

  .prop {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 4px 12px;
  }

  .prop:first-child {
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border-color: var(--color-accent-border);
  }

  .filters-row {
    display: block;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-left: 34px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 12px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-border) 8%,
      var(--color-border) 92%,
      transparent
    );
  }

  .empty {
    margin: var(--space-5) 0 0;
    padding: var(--space-5);
    text-align: center;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  .empty span {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 1px solid var(--color-border);
  }

  .toc__link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 10px;
    margin-left: -1px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-dim);
    text-decoration: none;
    border-left: 1px solid transparent;
    transition:
      color 0.16s ease,
      border-color 0.16s ease;
  }

  .toc__link:hover {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  .toc__dot {
    width: 5px;
    height: 5px;
    flex-shrink: 0;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }

  @media (max-width: 1180px) {
    .hub {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: var(--space-5);
    }

    .toc-panel {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .hub-header__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      padding: 12px 16px;
    }

    .brand__title {
      white-space: normal;
      font-size: var(--fs-md);
    }

    .search {
      max-width: none;
    }

    .hub {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-4) 16px 72px;
    }

    .sidebar {
      position: static;
      max-height: none;
      overflow: visible;
    }

    .sidebar__list {
      flex-direction: row;
      overflow-x: auto;
      padding-bottom: var(--space-2);
    }

    .sidebar__list li {
      flex: 0 0 auto;
    }

    .cat-btn {
      width: auto;
      white-space: nowrap;
    }

    .sidebar__foot {
      display: none;
    }

    .timeline {
      padding-left: 24px;
    }

    .timeline::before {
      left: 8px;
    }

    .category__title {
      font-size: var(--fs-xl);
    }
  }
</style>
