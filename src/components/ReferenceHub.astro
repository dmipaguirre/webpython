---
import { categories, categoryIcons, initialKey, loopCategory, totalMethods, totalTopics } from '../data';
import ContentPanel from './hub/ContentPanel.astro';
import HubHeader from './hub/HubHeader.astro';
import LoopCard from './bucles/LoopCard.astro';
import MethodCard from './estructuras/MethodCard.astro';
import NavigationSidebar from './navigation/NavigationSidebar.astro';
import SearchResults from './search/SearchResults.astro';
import TableOfContents from './navigation/TableOfContents.astro';
---

<HubHeader />

<div class="hub">
  <NavigationSidebar
    categories={categories}
    loopCategory={loopCategory}
    activeKey={initialKey}
    total={totalMethods + totalTopics}
    icons={categoryIcons}
  />

  <main class="content">
    {
      categories.map(({ key, data }) => (
        <ContentPanel panelKey={key} data={data} kind="methods" activeKey={initialKey} />
      ))
    }

    <ContentPanel panelKey={loopCategory.key} data={loopCategory.data} kind="topics" activeKey={initialKey} />

    <SearchResults />

    {
      categories
        .filter(({ key }) => key !== initialKey)
        .map(({ key, data }) => (
          <template data-cards={key}>
            {data.methods.map((method) => (
              <MethodCard method={method} />
            ))}
          </template>
        ))
    }

    <template data-cards={loopCategory.key}>
      {loopCategory.data.topics.map((topic) => <LoopCard topic={topic} />)}
    </template>
  </main>

  <TableOfContents categories={categories} loopCategory={loopCategory} activeKey={initialKey} />
</div>

<script>
  import '../scripts/referenceHub';
</script>

<style>
  .hub {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr) 232px;
    gap: var(--space-6);
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--space-5) 24px 96px;
    align-items: start;
  }

  .content {
    min-width: 0;
  }

  @media (max-width: 1180px) {
    .hub {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  @media (max-width: 820px) {
    .hub {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-4) 16px 72px;
    }
  }
</style>
